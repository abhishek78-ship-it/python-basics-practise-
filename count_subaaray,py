t = int(input())

for _ in range(t):
    n = int(input())
    a = list(map(int, input().split()))

    ans = 0
    length = 1

    for i in range(n):
        if i > 0 and a[i] >= a[i - 1]:
            length += 1
        else:
            length = 1

        ans += length

    print(ans)